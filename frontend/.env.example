# =============================================================
# Frontend HORS Docker (npm run dev lancé directement en local).
# En Docker, ces variables viennent du .env RACINE, injectées par
# docker-compose.dev.yml — elles ont alors priorité sur ce fichier.
# =============================================================

# En développement avec Vite, localhost est accepté. Pour un build Docker ou
# Railway staging/production, fournir une URL API HTTPS publique et non locale.
VITE_API_BASE_URL=
VITE_MATOMO_URL=

# Stripe (mode test) : clé publique pk_test_… — Dashboard Stripe →
# Developers → API keys. Laisser vide = paiement simulé (sans Stripe).
VITE_STRIPE_PUBLISHABLE_KEY=
