{
  "name": "sailingloc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon --watch src --exec node src/server.js",
    "start": "node src/server.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "files:migrate": "node scripts/migrate-private-files.js",
    "seed:reviews": "node prisma/addMissingReviews.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.{js,mjs}",
    "format": "prettier --write src/**/*.{js,mjs,json,md}"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "csurf": "npm:@dr.pogodin/csurf@1.17.1",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.19.1",
    "prisma": "^5.0.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
