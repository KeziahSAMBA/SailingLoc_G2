# =============================================================
# Backend HORS Docker (node src/server.js lancé directement).
# En Docker, ces variables viennent du .env RACINE, injectées par
# docker-compose.dev.yml — elles ont alors priorité sur ce fichier.
# =============================================================

DATABASE_URL=
NODE_ENV=development
# Cible de déploiement Stripe : staging ou production. Laisser vide en local.
# En staging, NODE_ENV peut rester production pour conserver les protections
# runtime tout en utilisant une clé Stripe sk_test_.
DEPLOYMENT_ENV=
PORT=4000
APP_URL=http://localhost:5173
# Origine publique de l'API, utilisée pour construire les URL des fichiers
# exposés sous /uploads (ne jamais la déduire de l'en-tête Host).
PUBLIC_API_URL=http://localhost:4000
# Origines frontend supplémentaires, séparées par des virgules ; vide = APP_URL.
CORS_ORIGINS=
JWT_SECRET=

# Stripe (mode test) : sk_test_… — Dashboard Stripe → Developers → API keys.
# Laisser vide = paiement simulé (sans Stripe).
STRIPE_SECRET_KEY=
# whsec_… fourni par `stripe listen` (dev) ou le dashboard (prod)
STRIPE_WEBHOOK_SECRET=

# Chiffrement au repos des documents (AES-256-GCM) — `openssl rand -hex 32`
FILE_ENCRYPTION_KEY=
# Les fichiers privés historiques en clair sont refusés par défaut en
# staging/production. N'activer ce secours que pendant une migration contrôlée.
ALLOW_LEGACY_CLEAR_FILE_READ=false

# Email — dev : MailDev en local (docker compose up maildev), aucun vrai compte requis
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
# Uniquement pour MailDev en développement local ; interdit en staging/prod.
EMAIL_IGNORE_TLS=true
# Email — prod (Railway) : API HTTP Mailgun (SMTP bloqué). Si MAILGUN_API_KEY est
# renseignée, elle prend le pas sur EMAIL_*. Région EU : MAILGUN_HOST=api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_HOST=

# Réservé aux bases locales de développement ; interdit en production/staging.
SEED_FORCE=false
