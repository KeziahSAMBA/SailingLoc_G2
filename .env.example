# =============================================================
# Fichier .env de la RACINE = utilisé par Docker (docker-compose).
# Compose lit automatiquement ce fichier pour injecter les ${VAR}.
# Pour lancer le back/front HORS Docker, voir backend/.env.example
# et frontend/.env.example (valeurs adaptées en localhost).
# =============================================================

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend
DATABASE_URL=
JWT_SECRET=
STRIPE_SECRET_KEY=
# Webhooks Stripe : whsec_… fourni par `stripe listen` (dev) ou le dashboard (prod)
STRIPE_WEBHOOK_SECRET=
# Email — dev : MailDev en SMTP (aucun vrai compte requis)
# Avec Docker : EMAIL_HOST=maildev | Sans Docker : EMAIL_HOST=localhost
EMAIL_HOST=maildev
EMAIL_PORT=1025
# Email — prod (Railway) : API HTTP Mailgun, car les ports SMTP sortants sont
# bloqués. Si MAILGUN_API_KEY est renseignée, elle prend le pas sur EMAIL_*.
MAILGUN_API_KEY=
# Domaine d'envoi enregistré dans Mailgun (ex. mg.mondomaine.fr ou sandbox…mailgun.org)
MAILGUN_DOMAIN=
# Région EU uniquement : api.eu.mailgun.net (défaut : api.mailgun.net)
MAILGUN_HOST=

# Frontend
VITE_API_BASE_URL=
# Stripe (mode test) : pk_test_… — la clé secrète sk_test_… va dans
# STRIPE_SECRET_KEY ci-dessus. Laisser vide = paiement simulé (sans Stripe).
VITE_STRIPE_PUBLISHABLE_KEY=

# pgAdmin (dev only)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Chiffrement au repos des documents (AES-256-GCM) — générer avec : openssl rand -hex 32
# Clé différente par environnement ; si perdue, les fichiers chiffrés sont illisibles.
FILE_ENCRYPTION_KEY=

# Matomo (mesure d'audience self-hosted — base MariaDB dédiée)
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=
MATOMO_DB_ROOT_PASSWORD=
# Tests de montée en charge (k6) — environnement dédié UNIQUEMENT.
# À true : désactive le rate limiting, l'envoi réel d'emails et les tâches
# planifiées. Ne jamais poser en production.
LOAD_TEST_MODE=false
