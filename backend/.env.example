DATABASE_URL=postgresql://user:password@localhost:5432/sailingloc
JWT_SECRET=your_jwt_secret
STRIPE_SECRET_KEY=sk_test_yourkey
# Email — MailDev (sans Docker : lancer `npx maildev` dans un terminal)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
# TLS : en prod, NE PAS désactiver. Port 465 = TLS implicite (ou EMAIL_SECURE=true) ; 587 = STARTTLS auto.
# EMAIL_IGNORE_TLS=true uniquement pour MailDev en local (MailDev ne gère pas TLS).
EMAIL_IGNORE_TLS=true
EMAIL_SECURE=false
PORT=4000
# Environnement : laisser vide (ou "development") en local.
# En production (Railway, etc.) METTRE "production" → active les cookies Secure/SameSite + trust proxy.
NODE_ENV=development
