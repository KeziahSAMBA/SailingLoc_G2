# Dependencies and generated output are not part of the build context.
node_modules
dist
coverage
.nyc_output

# Never send credentials or local environment overrides to the Docker daemon.
.env
.env.*
!.env.example

# Repository metadata, editor state and local diagnostics.
.git
.github
.vscode
*.log
*.pid

# Local screenshots/diagnostics at the package root (application assets under
# src/assets remain part of the build context).
debug-full.png
gallery-*.png
