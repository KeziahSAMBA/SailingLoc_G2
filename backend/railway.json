{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run prisma:generate --workspace backend",
    "watchPatterns": ["backend/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "preDeployCommand": ["npx prisma migrate deploy --schema backend/prisma/schema.prisma"],
    "startCommand": "npm start --workspace backend",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
