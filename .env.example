# =============================================================
# Fichier .env de la RACINE = utilisé par Docker (docker-compose).
# Compose lit automatiquement ce fichier pour injecter les ${VAR}.
# Pour lancer le back/front HORS Docker, voir backend/.env.example
# et frontend/.env.example (valeurs adaptées en localhost).
# =============================================================

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend
DATABASE_URL=
# En local : http://localhost:5173. En production : URL HTTPS publique.
APP_URL=http://localhost:5173
# Origine publique de l'API qui sert aussi /uploads/boats et /uploads/avatars.
# En production/staging : URL HTTPS publique, sans chemin ni identifiants.
PUBLIC_API_URL=http://localhost:4000
# Origines frontend supplémentaires autorisées pour les requêtes avec cookie,
# séparées par des virgules (vide = APP_URL uniquement). En staging/production,
# chaque origine doit être HTTPS.
CORS_ORIGINS=
JWT_SECRET=
STRIPE_SECRET_KEY=
# Webhooks Stripe : whsec_… fourni par `stripe listen` (dev) ou le dashboard (prod)
STRIPE_WEBHOOK_SECRET=
# Email — dev : MailDev en SMTP (aucun vrai compte requis)
# Avec Docker : EMAIL_HOST=maildev | Sans Docker : EMAIL_HOST=localhost
EMAIL_HOST=maildev
EMAIL_PORT=1025
EMAIL_SECURE=false
# MailDev dev-only peut utiliser true ; laisser false pour staging/production.
EMAIL_IGNORE_TLS=false
# Email — prod (Railway) : API HTTP Mailgun, car les ports SMTP sortants sont
# bloqués. Si MAILGUN_API_KEY est renseignée, elle prend le pas sur EMAIL_*.
MAILGUN_API_KEY=
# Domaine d'envoi enregistré dans Mailgun (ex. mg.mondomaine.fr ou sandbox…mailgun.org)
MAILGUN_DOMAIN=
# Région EU uniquement : api.eu.mailgun.net (défaut : api.mailgun.net)
MAILGUN_HOST=

# Frontend
# URL API consommée par le bundle Vite. Obligatoire en staging/production :
# une URL HTTPS publique (ex. https://api.sailingloc.fr/api), jamais localhost.
VITE_API_BASE_URL=
# Stripe (mode test) : pk_test_… — la clé secrète sk_test_… va dans
# STRIPE_SECRET_KEY ci-dessus. Laisser vide = paiement simulé (sans Stripe).
VITE_STRIPE_PUBLISHABLE_KEY=

# pgAdmin (dev only)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Chiffrement au repos des documents (AES-256-GCM) — générer avec : openssl rand -hex 32
# Clé différente par environnement ; si perdue, les fichiers chiffrés sont illisibles.
FILE_ENCRYPTION_KEY=
# Secours de lecture temporaire pour une migration contrôlée ; false en
# staging/production (valeur sûre par défaut).
ALLOW_LEGACY_CLEAR_FILE_READ=false
# Le seed de démonstration est réservé au profil development.
SEED_FORCE=false

# Redis optionnel (compose production uniquement) : aucune valeur par défaut
# n'est acceptée par le conteneur authentifié.
REDIS_PASSWORD=

# Matomo (mesure d'audience self-hosted — base MariaDB dédiée)
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=
MATOMO_DB_ROOT_PASSWORD=
# URL publique de Matomo, chargée uniquement après consentement analytics.
VITE_MATOMO_URL=
